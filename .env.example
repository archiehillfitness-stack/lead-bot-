# --- Instagram / Meta app -------------------------------------------------
# Long-lived access token for your Instagram professional account
# (Instagram API with Instagram Login, permissions: instagram_business_basic,
# instagram_business_manage_messages, instagram_business_manage_comments).
IG_ACCESS_TOKEN=
# Your Instagram professional account's user ID (the numeric IG user ID).
IG_USER_ID=
# App secret from the Meta developer dashboard. Used to verify that webhook
# requests really come from Meta.
APP_SECRET=
# Any random string. Paste the same value into the webhook setup in the Meta
# dashboard.
VERIFY_TOKEN=
# Graph API host and version. Defaults work for "Instagram API with Instagram Login".
GRAPH_HOST=https://graph.instagram.com
GRAPH_API_VERSION=v23.0

# --- Dashboard ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Storage / content ----------------------------------------------------
DATABASE_PATH=leads.db
CONTENT_PATH=content.yaml
# Set to 1 to log outgoing messages instead of sending them (for testing).
DRY_RUN=0
